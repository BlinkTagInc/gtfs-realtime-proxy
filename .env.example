GTFS_VEHICLEPOSITIONS_URL=https://svc.metrotransit.org/mtgtfs/vehiclepositions.pb
GTFS_TRIPUPDATES_URL=https://svc.metrotransit.org/mtgtfs/tripupdates.pb
GTFS_ALERTS_URL=https://svc.metrotransit.org/mtgtfs/alerts.pb

# Optional server-side request headers. Feed-specific values override shared ones.
# GTFS_HEADERS={"X-API-Key":"replace-me"}
# GTFS_ALERTS_HEADERS={"Authorization":"Bearer replace-me"}

# GTFS_VEHICLEPOSITIONS_CACHE_SECONDS=5
# GTFS_TRIPUPDATES_CACHE_SECONDS=5
# GTFS_ALERTS_CACHE_SECONDS=60

# Optional project-wide overrides. Leave unset to use the feed-specific defaults.
# Browser caching defaults to each feed's cache lifetime (an override caps it).
# GTFS_BROWSER_CACHE_SECONDS=5
# Background refresh window defaults to 0 seconds for positions/trips, 5 for alerts.
# GTFS_SWR_SECONDS=0
# Error fallback defaults to 30 seconds for positions/trips, 120 for alerts.
# GTFS_STALE_IF_ERROR_SECONDS=30
