{
  "name": "gtfs-realtime-proxy",
  "description": "An API to retrieve GTFS-Realtime data and add CORS headers",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "transit",
    "gtfs-realtime"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/BlinkTagInc/gtfs-realtime-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/BlinkTagInc/gtfs-realtime-proxy/issues"
  },
  "homepage": "https://github.com/BlinkTagInc/gtfs-realtime-proxy#readme",
  "license": "MIT",
  "author": "Brendan Nee <brendan@blinktag.com>",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "singleQuote": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "prettier --write",
    "*.jsx": "prettier --write",
    "*.ts": "prettier --write",
    "*.tsx": "prettier --write",
    "*.json": "prettier --write"
  },
  "packageManager": "pnpm@12.3.4"
}
